{
  /* The wallet port's embedded-wallet implementation. DOM and jsx, unlike wallet/: the vendor's
     SDK is a React provider and needs both. The pure part (store.ts) imports neither, and is
     what the tests drive. */
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src"]
}
