{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* Node 24 runs .ts directly via type stripping. We never emit JS — tsc is a
       checker only. That is why noEmit is true everywhere and there is no build step. */
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* Type stripping cannot erase these, so they are banned outright. */
    "erasableSyntaxOnly": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "useUnknownInCatchVariables": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
