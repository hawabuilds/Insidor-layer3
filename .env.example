# Copy to .env.local and fill in. Never commit the filled copy.
#
# Config is read ONCE at startup through a single validated module. A missing value
# fails the process loudly at boot rather than defaulting to something plausible —
# the previous build defaulted a missing key and ran for seven hours doing nothing.

# ── database ──────────────────────────────────────────────────────────────────
# One Postgres, three schemas: public (what the app may read), internal (decisions,
# labels, features — the app has NO grant here), raw (vendor captures).
DATABASE_URL=postgresql://user:pass@host:5432/insidor
# Separate role for the app. Read-only, public schema only. This is the second half
# of "the app cannot show internal scoring" — the first half is the wire types.
DATABASE_URL_APP=postgresql://app:pass@host:5432/insidor

# ── social sources ────────────────────────────────────────────────────────────
# X via reseller. Billed per post returned, so every call passes through the meter.
X_API_KEY=
X_API_BASE=https://api.twitterapi.io

# TikTok via scraper. Note it has no server-side time cutoff, so it cannot be used
# for a blind historical run — see adapters/platform/tiktok.
APIFY_TOKEN=

# ── chain and market ──────────────────────────────────────────────────────────
# The mint stream. One long-lived websocket, its own process (services/chainwatch).
PUMPPORTAL_WS=wss://pumpportal.fun/api/data
# RPC for confirming mint times. Every outcome label hangs on this being right.
SOLANA_RPC_URL=
HELIUS_API_KEY=

# ── judge ─────────────────────────────────────────────────────────────────────
# Used only where a trained model does not exist yet. Bounded by a hard daily cap:
# when the cap is hit the stage PAUSES rather than quietly running up a bill.
ANTHROPIC_API_KEY=
DAILY_BUDGET_USD=5

# ── embeddings ────────────────────────────────────────────────────────────────
# Grouping needs real sentence embeddings. The previous build used bag-of-words word
# counting under the name "embeddings", which is why 91% of its stories held a single
# post by a single author.
EMBEDDING_API_KEY=

# ── runtime ───────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
