# Insidor — environment variables
# Copy to .env.local for local `vercel dev`, or set in Vercel → Project → Settings → Environment Variables.
# Never commit real keys. .env.local is gitignored.

# ── Layer 2: Vercel /api/* (market data, safety, trading proxies) ─────────────

# Birdeye — OHLCV, recent swaps, top traders (server-side; CU limits on free tier)
BIRDEYE_API_KEY=

# Helius — Solana RPC: wallet SOL/SPL balances, token holder distribution
HELIUS_API_KEY=

# Jupiter — swap quotes & unsigned transactions (key stays server-side via /api/quote, /api/swap)
JUPITER_API_KEY=

# ── Layer 3: worker + narratives pipeline (not used on Layer 2 deploy) ────────

# Supabase — Postgres persistence for narratives, posts, clusters
# Browser anon key is hardcoded in site/config.js (RLS-protected). SERVICE key: worker + /api only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side / worker only — bypasses RLS; never expose to the browser
SUPABASE_SERVICE_KEY=

# X ingestion via twitterapi.io (worker polls / clusters viral posts)
X_API_KEY=
# Optional override; default in worker: https://api.twitterapi.io
X_API_BASE=

# Anthropic — narrative clustering, summarisation, deploy copy (worker)
ANTHROPIC_API_KEY=

# SerpAPI — Google Trends interest-over-time for narrative sparklines (worker/trends.js)
# Set on Railway alongside other worker env vars. Free tier ~250 searches/mo — cap with MAX_TRENDS_CALLS_PER_DAY.
SERPAPI_KEY=
# Optional daily SerpAPI call cap (default 200)
MAX_TRENDS_CALLS_PER_DAY=200
